@page
@model DetailsModel

<h2 class="my-3">@Model.Bicicleta.Nome</h2>
<div class="row">
    <div class="col-4">
        <img class="img-fluid rounded" src="@Model.Bicicleta.ImagemUri">
    </div>
    <div class="col-6">
        <h4 class="my-3">Sobre:</h4>
        <p>@Model.Bicicleta.Descricao</p>
        <h4 class="my-3">Mais Info:</h4>
        <ul>
            <li>Preço: @Model.Bicicleta.Preco</li>
            <li>Entrega Expressa: @Model.Bicicleta.EntregaExpressa</li>
            <li>Data Cadastro: @Model.Bicicleta.DataCadastro</li>
        </ul>
        <a class="btn my-3 btn-primary">Editar</a>
    </div>
</div>
